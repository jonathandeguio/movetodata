# Copy this file to .env.test and fill in the values.
# .env.test is git-ignored — never commit real credentials.

# URL of the MoveToData frontend (Nginx on port 8081 in standard deployment).
BASE_URL=http://localhost:8081

# Credentials for the dedicated E2E test account (not a production account).
TEST_USER=e2e-test-user
TEST_PASSWORD=CHANGE_ME

# Set to "true" to intercept /api/ai/* calls with mock responses instead of
# hitting the real Ollama-backed service. Useful in CI without GPU.
MOCK_AI=true
