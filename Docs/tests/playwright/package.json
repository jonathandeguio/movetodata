    "test:auth": "dotenv -e .env.test -- playwright test specs/F-AUTH/",
    "test:portal": "dotenv -e .env.test -- playwright test specs/F-PORTAL/",
    "test:connect": "dotenv -e .env.test -- playwright test specs/F-CONNECT/",
    "test:dataset": "dotenv -e .env.test -- playwright test specs/F-DATASET/",
    "test:kepler": "dotenv -e .env.test -- playwright test specs/F-KEPLER/",
    "test:settings": "dotenv -e .env.test -- playwright test specs/F-SETTINGS/",
    "test:ai": "dotenv -e .env.test -- playwright test specs/F-AI/",
    "test:docs": "dotenv -e .env.test -- playwright test specs/F-DOCS/",
    "test:scenarios": "dotenv -e .env.test -- playwright test specs/F-SCENARIOS/",
    "test:scenarios:retail": "dotenv -e .env.test -- playwright test specs/F-SCENARIOS/F-SCENARIOS-01-retail.spec.ts",
    "test:scenarios:tech": "dotenv -e .env.test -- playwright test specs/F-SCENARIOS/F-SCENARIOS-02-tech.spec.ts",
    "test:scenarios:manufacturing": "dotenv -e .env.test -- playwright test specs/F-SCENARIOS/F-SCENARIOS-03-manufacturing.spec.ts",
    "test:scenarios:finance": "dotenv -e .env.test -- playwright test specs/F-SCENARIOS/F-SCENARIOS-04-finance.spec.ts",
    "test:ui": "dotenv -e .env.test -- playwright test --ui",
