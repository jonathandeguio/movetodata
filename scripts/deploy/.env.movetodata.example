# =============================================================================
# MoveToData Platform — Exemple de fichier d'environnement
# Copier ce fichier en .env.movetodata et renseigner les vraies valeurs.
# NE PAS committer .env.movetodata dans git (secrets).
# =============================================================================

# --- Général ---
MOVETODATA_MOUNT_PATH=/opt/movetodata/data
BASE_URL=http://192.168.1.78:8081
ALLOWED_ORIGINS=http://192.168.1.78:8081,http://localhost:3000

# --- JWT / Auth Boson ---
TOKEN_SECRET=CHANGEME_generate_with_openssl_rand_hex_64
TOKEN_EXPIRATION=604800000
REFRESH_TOKEN_SECRET=CHANGEME_generate_with_openssl_rand_hex_64

# --- Base de données Boson ---
BOSON_DB_HOST=boson-db
BOSON_DB_PORT=5432
BOSON_DB_NAME=boson
BOSON_DB_USERNAME=movetodata
BOSON_DB_PASSWORD=CHANGEME_strong_password

# --- Base de données Snap ---
SNAP_DB_HOST=snap-db
SNAP_DB_PORT=5432
SNAP_DB_NAME=postgres
SNAP_DB_USERNAME=postgres
SNAP_DB_PASSWORD=CHANGEME_strong_password

# --- Base de données Tycho (Superset) ---
TYCHO_DB_HOST=tycho-db
TYCHO_DB_PORT=5432
TYCHO_DB_NAME=superset
TYCHO_DB_USERNAME=superset
TYCHO_DB_PASSWORD=CHANGEME_strong_password

# --- Redis ---
REDIS_HOST=movetodata-redis
REDIS_PORT=6379

# --- Tycho / Superset ---
SUPERSET_SECRET_KEY=CHANGEME_generate_with_openssl_rand_base64_42
SUPERSET_PORT=8088
FLASK_ENV=production
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no

# --- Snap ---
ARTIFACT_STORE=/movetodata/snap/artifactory
SNAP_LOG_FILE_PATH=/movetodata/snap/logs
SNAP_TOKEN_SECRET=CHANGEME_same_as_TOKEN_SECRET_or_dedicated
SNAP_TOKEN_EXPIRATION=604800000
GITHUB_PAT=CHANGEME_github_pat

# --- SAML SSO ---
SAML2_SSO_CONFIG=file:/etc/movetodata/saml.yml

# --- Swagger (désactiver en prod) ---
SWAGGER_UI=false

# --- OAuth2 ---
GITHUB_OAUTH_CLIENT_ID=CHANGEME_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=CHANGEME_github_oauth_client_secret
GOOGLE_OAUTH_CLIENT_ID=CHANGEME_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=CHANGEME_google_oauth_client_secret

# --- AI Service ---
OLLAMA_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=120

# =============================================================================
# Couche Data — Sécurité & Chiffrement
# =============================================================================

# --- Row Level Security PostgreSQL ---
# Lorsque POSTGRES_RLS_ENABLED=true, Boson active au démarrage les politiques
# RLS sur les tables sensibles (datasets, projets, sources).
# La commande SQL côté applicatif : ALTER TABLE <t> ENABLE ROW LEVEL SECURITY;
POSTGRES_RLS_ENABLED=true

# --- Chiffrement at-rest (volumes Docker) ---
# Le chiffrement des volumes PostgreSQL et du stockage fichier est assuré au
# niveau du système de fichiers hôte (dm-crypt/LUKS sur Ubuntu) ou via un HSM/KMS
# externe on-premise. Ces variables documentent le point d'intégration.
#
# Option 1 — LUKS sur le host :
#   Monter /opt/movetodata/data sur un volume LUKS avant de démarrer la stack.
#   Pas de variable Docker requise — transparent pour les conteneurs.
#
# Option 2 — KMS on-premise (ex: HashiCorp Vault, Thales Luna HSM) :
#   Les clés de chiffrement ne transitent jamais vers un cloud US.
#
# ENCRYPTION_KMS_URL=http://vault.internal:8200
# ENCRYPTION_KMS_ROLE_ID=CHANGEME
# ENCRYPTION_KMS_SECRET_ID=CHANGEME
# ENCRYPTION_TRANSIT_KEY=movetodata-data-key
#
# Note : le chiffrement en transit (TLS) entre les conteneurs est assuré par
# le réseau Docker bridge interne (movetodata-network) et par le reverse-proxy
# nginx pour les communications externes. Activer TLS mutuel (mTLS) si la
# politique de sécurité l'exige.
