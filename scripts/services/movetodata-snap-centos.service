# =============================================================================
# MoveToData Snap — Service systemd (CentOS / RHEL)
#
# Prérequis : movetodata-platform.service doit être démarré en premier.
#
# Installation :
#   sudo cp movetodata-snap-centos.service /etc/systemd/system/movetodata-snap.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable movetodata-snap
#   sudo systemctl start movetodata-snap
#
# Vérification :
#   sudo systemctl status movetodata-snap
#   sudo journalctl -u movetodata-snap -f
# =============================================================================
[Unit]
Description=MoveToData Snap Artifact Service (CentOS/RHEL)
Documentation=https://movetodata.io/docs
Requires=docker.service movetodata-platform.service
After=docker.service movetodata-platform.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=movetodata
Group=movetodata

WorkingDirectory=/opt/movetodata/scripts

EnvironmentFile=/opt/movetodata/scripts/.env.movetodata

# Démarrage avec SELinux preflight + vérification FUSE
ExecStartPre=/bin/bash -c "modprobe fuse 2>/dev/null || true"
ExecStartPre=/bin/bash -c "test -c /dev/fuse || (echo 'ERROR: /dev/fuse manquant' && exit 1)"
ExecStart=/bin/bash /opt/movetodata/scripts/03-start-centos.sh --stack snap

ExecStop=/usr/bin/docker compose \
  -f /opt/movetodata/scripts/docker-compose.snap.yml \
  --env-file /opt/movetodata/scripts/.env.movetodata \
  down

TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
