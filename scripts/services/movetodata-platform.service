# =============================================================================
# MoveToData Platform — Service systemd
# Installation :
#   sudo cp movetodata-platform.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable movetodata-platform
#   sudo systemctl start movetodata-platform
# =============================================================================
[Unit]
Description=MoveToData Platform (Core Stack)
Documentation=https://movetodata.io/docs
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=movetodata
Group=movetodata

WorkingDirectory=/opt/movetodata/scripts

# Chargement des variables d'environnement
EnvironmentFile=/opt/movetodata/scripts/.env.movetodata

# Démarrage
ExecStart=/usr/bin/docker compose \
  -f /opt/movetodata/scripts/docker-compose.core.yml \
  --env-file /opt/movetodata/scripts/.env.movetodata \
  up -d --remove-orphans

# Arrêt
ExecStop=/usr/bin/docker compose \
  -f /opt/movetodata/scripts/docker-compose.core.yml \
  down

# Rechargement (restart des containers)
ExecReload=/usr/bin/docker compose \
  -f /opt/movetodata/scripts/docker-compose.core.yml \
  restart

TimeoutStartSec=300
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
