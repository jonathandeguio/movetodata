# =============================================================================
# MoveToData Platform — Service systemd (CentOS / RHEL)
#
# Installation :
#   sudo cp movetodata-platform-centos.service /etc/systemd/system/movetodata-platform.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable movetodata-platform
#   sudo systemctl start movetodata-platform
#
# Vérification :
#   sudo systemctl status movetodata-platform
#   sudo journalctl -u movetodata-platform -f
# =============================================================================
[Unit]
Description=MoveToData Platform (Core Stack — CentOS/RHEL)
Documentation=https://movetodata.io/docs
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=movetodata
Group=movetodata

# Répertoire de travail sur CentOS (/opt/movetodata/repo)
WorkingDirectory=/opt/movetodata/repo/scripts

# Chargement des variables d'environnement
EnvironmentFile=/opt/movetodata/repo/scripts/.env.movetodata

# Démarrage avec SELinux preflight
ExecStart=/bin/bash /opt/movetodata/repo/scripts/03-start-centos.sh --stack core

# Arrêt via docker compose down
ExecStop=/usr/bin/docker compose \
  -f /opt/movetodata/repo/scripts/docker-compose.core.yml \
  --env-file /opt/movetodata/repo/scripts/.env.movetodata \
  down

# Rechargement = restart des containers
ExecReload=/usr/bin/docker compose \
  -f /opt/movetodata/repo/scripts/docker-compose.core.yml \
  --env-file /opt/movetodata/repo/scripts/.env.movetodata \
  restart

TimeoutStartSec=300
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
