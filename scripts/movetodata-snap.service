# =============================================================================
# MoveToData Snap — Service systemd
# Installation :
#   sudo cp movetodata-snap.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable movetodata-snap
#   sudo systemctl start movetodata-snap
# =============================================================================
[Unit]
Description=MoveToData Snap Artifact Service
Documentation=https://movetodata.io/docs
Requires=docker.service movetodata-platform.service
After=docker.service movetodata-platform.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=movetodata
Group=movetodata

WorkingDirectory=/home/movetodata/movetodata_repo/scripts

EnvironmentFile=/home/movetodata/movetodata_repo/scripts/.env.movetodata

ExecStart=/usr/bin/docker compose \
  -f /home/movetodata/movetodata_repo/scripts/docker-compose.snap.yml \
  --env-file /home/movetodata/movetodata_repo/scripts/.env.movetodata \
  up -d --remove-orphans

ExecStop=/usr/bin/docker compose \
  -f /home/movetodata/movetodata_repo/scripts/docker-compose.snap.yml \
  down

TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
