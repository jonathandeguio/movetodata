[Unit]
Description=MoveToData Platform (Docker Compose)
Documentation=https://github.com/jonathandeguio/movetodata
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=orion
Group=orion
WorkingDirectory=/opt/movetodata/scripts

# Démarrage : lance la stack core (boson + frontend + postgres + redis)
ExecStart=/bin/bash /opt/movetodata/scripts/03-start.sh core

# Arrêt propre
ExecStop=/bin/bash /opt/movetodata/scripts/04-stop.sh core

# Si le démarrage échoue, ne pas boucler indéfiniment
Restart=no

# Logs disponibles via : journalctl -u movetodata
StandardOutput=journal
StandardError=journal
SyslogIdentifier=movetodata

[Install]
WantedBy=multi-user.target
